subtitle: -1 resources
choose-if: resources > 0 and ((rfb_banned or rfb_banned_prussia) and (left_strength >= reformist_strength + neorevisionist_strength + center_strength)) or (not (rfb_banned or rfb_banned_prussia) and (left_strength >= reformist_strength + neorevisionist_strength))
