title: Antifaschistische Aktion
subtitle: Communist forces unite against the far-right
new-page: true
on-arrival: afa_seen = 1; rfb_strength += 100; rfb_militancy += 0.1; workers_kpd += 3; unemployed_kpd += 3; nationalism -= 3; nazi_urgency += 1;
